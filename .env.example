# Your existing variable names work as-is. Never put these in public/.
CLIENTID=
CLIENTSECRET=

# The browser-facing URL serving this app. In the Tesla developer portal,
# set Allowed Origin to this URL and Allowed Redirect URI to:
# https://your-domain.example/auth/callback
# Use an HTTPS domain you control, pointing to this app through a reverse proxy.
APP_URL=https://your-domain.example

# na: North America / Asia-Pacific (excluding China)
# eu: Europe / Middle East / Africa
TESLA_REGION=na
PORT=3000
HOST=127.0.0.1
