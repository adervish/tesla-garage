{
  "name": "tesla-garage",
  "main": "cloudflare/worker.mjs",
  "account_id": "807e334ccab0b782738d91f36e4338ba",
  "compatibility_date": "2026-03-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tesla.dangerously-skipped-permissions.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_URL": "https://tesla.dangerously-skipped-permissions.com",
    "TESLA_REGION": "na"
  },
  "services": [{ "binding": "COMMANDS", "service": "tesla-garage-commands" }],
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "TeslaSession" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TeslaSession"] }
  ],
  "ratelimits": [
    { "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
